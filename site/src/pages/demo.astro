---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const title = 'Prueba la red';
const description =
  'Una red de pagos instantáneos completa —el SIP, dos redes y cuatro instituciones ficticias— que puedes manejar desde el navegador: resuelve una llave, envía un pago y liquida la malla.';
const disclaimer =
  'Demostración con datos ficticios. Proyecto Caudal es independiente y no está afiliado al Banco Central del Ecuador.';

const institutions = [
  ['banco-alfa', 'banco-alfa · red alfa'],
  ['mutual-delta', 'mutual-delta · red alfa'],
  ['coop-beta', 'coop-beta · red beta'],
  ['fintech-gamma', 'fintech-gamma · red beta'],
];
const llaves = [
  ['llave-01', 'llave-01 · celular · coop-beta'],
  ['llave-02', 'llave-02 · correo · banco-alfa'],
  ['llave-03', 'llave-03 · identificación · fintech-gamma'],
  ['llave-04', 'llave-04 · alfanumérica · mutual-delta'],
  ['llave-05', 'llave-05 · celular · banco-alfa'],
  ['llave-06', 'llave-06 · correo · coop-beta'],
  ['llave-07', 'llave-07 · celular · coop-beta (cuenta bloqueada)'],
  ['llave-08', 'llave-08 · alfanumérica · banco-alfa (cuenta cerrada)'],
];
---

<Base title={title} description={description}>
  <article class="container container--narrow prose demo" data-api={SITE.demoApi}>
    <p class="demo__kicker">Demo en vivo</p>
    <h1>{title}</h1>
    <p class="demo__disclaimer" role="note">{disclaimer}</p>

    <p>
      Detrás de esta página corre una red de pagos instantáneos completa: el Sistema Integrador de
      Pagos (SIP), dos redes de pagos que compiten entre sí y cuatro instituciones ficticias. Cada
      mensaje entre ellas es un <code>pacs.008</code> o un <code>pacs.002</code> firmado, igual que
      en producción. Es el mismo programa que puedes correr en tu computadora.
    </p>
    <p>
      Para que aquí nunca entre un dato real, la demo solo acepta las instituciones y llaves del
      catálogo de prueba, y montos de hasta USD 1.000. Cada quince minutos la red vuelve a su
      estado inicial.
    </p>

    <section class="demo__panel" id="controls" hidden>
      <form id="pay">
        <label>
          Paga desde
          <select name="from">
            {institutions.map(([id, label]) => <option value={id}>{label}</option>)}
          </select>
        </label>
        <label>
          A la llave
          <select name="llave">
            {llaves.map(([id, label]) => <option value={id}>{label}</option>)}
          </select>
        </label>
        <label>
          Monto en USD
          <input name="amount" inputmode="decimal" value="25.40" pattern="\d{1,4}(\.\d{1,2})?" required />
        </label>
        <div class="demo__actions">
          <button type="button" class="btn btn--ghost" data-action="resolve">Resolver la llave</button>
          <button type="submit" class="btn btn--primary">Enviar el pago</button>
          <button type="button" class="btn btn--ghost" data-action="settle">Liquidar la malla</button>
        </div>
      </form>
      <div id="result" aria-live="polite"></div>
      <h2>La red ahora</h2>
      <div id="network" class="table-scroll"></div>
    </section>

    <section id="offline">
      <h2>Córrela en tu computadora</h2>
      <p>
        La demo en vivo todavía no está publicada. Mientras tanto, la misma red corre en tu
        computadora con un solo comando, sin Docker y sin cuentas en ningún lado:
      </p>
      <pre><code>git clone {SITE.github}
cd caudal-sip
just terminal</code></pre>
      <p>
        Se abre una terminal de pantalla completa con la bitácora de pagos, el cupo de cada
        institución con su semáforo y las posiciones netas de la malla. Prueba
        <code>pay coop-beta llave-02 25.40</code>, luego <code>show last xml</code> para ver cada
        mensaje, y <code>settle</code> para liquidar.
      </p>
    </section>

    <h2>Qué estás viendo</h2>
    <ul>
      <li>
        <strong><code>ACSP</code></strong>: el pago es irrevocable. Ocurre cuando la red
        beneficiaria lo recibe, antes de la liquidación.
      </li>
      <li>
        <strong><code>ACSC</code></strong>: la malla se liquidó y las posiciones netas se
        movieron entre las cuentas de las instituciones en el banco central.
      </li>
      <li>
        <strong><code>AM04</code></strong>: la institución que paga agotó su cupo. El cupo vuelve
        cuando se liquida la malla.
      </li>
      <li>
        <strong><code>AC06</code></strong> y <strong><code>AC04</code></strong>: la cuenta de
        destino está bloqueada o cerrada.
      </li>
    </ul>
    <p>
      ¿Qué pasa con un día entero de pagos? Lo simulamos:
      <a href="/simulacion/">un día de pagos de todo un país</a>.
    </p>
  </article>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('.demo')!;
  const api = root.dataset.api;
  const result = document.getElementById('result')!;
  const network = document.getElementById('network')!;
  const form = document.getElementById('pay') as HTMLFormElement;

  const usd = (v: string) => v.replace(/,/g, '_').replace('.', ',').replace(/_/g, '.');
  const el = (tag: string, text?: string, cls?: string) => {
    const node = document.createElement(tag);
    if (text !== undefined) node.textContent = text;
    if (cls) node.className = cls;
    return node;
  };

  async function call(method: string, path: string, body?: unknown) {
    const response = await fetch(`${api}${path}`, {
      method,
      headers: body ? { 'content-type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    const json = await response.json();
    if (!response.ok) throw new Error(json.error ?? `HTTP ${response.status}`);
    return json;
  }

  function show(...nodes: Node[]) {
    result.replaceChildren(...nodes);
  }

  function failure(error: unknown) {
    show(el('p', `No se pudo completar: ${error instanceof Error ? error.message : error}`, 'demo__error'));
  }

  async function refresh() {
    const n = await call('GET', '/api/network');
    const table = el('table');
    const head = el('tr');
    for (const h of ['Institución', 'Red', 'Cupo', 'Disponible', 'Usado', 'Semáforo', 'Posición neta']) head.append(el('th', h));
    table.append(head);
    for (const i of n.institutions) {
      const row = el('tr');
      for (const v of [i.id, i.red, usd(i.ceiling), usd(i.available), `${String(i.used_percent).replace('.', ',')} %`, i.light, usd(i.net)]) row.append(el('td', String(v)));
      row.children[5].className = `light light--${i.light}`;
      table.append(row);
    }
    network.replaceChildren(el('p', `Hora de la red: ${n.clock}`, 'demo__clock'), table);
  }

  function payment(p: any) {
    const nodes: Node[] = [
      el('p', `${p.from} → ${p.to} · USD ${usd(p.amount)}`, 'demo__headline'),
      el('p', `Resultado: ${p.label}`, `demo__state demo__state--${p.state}`),
    ];
    const list = el('ol', undefined, 'demo__hops');
    for (const h of p.hops) {
      const item = el('li');
      const outcome = h.state ? ` ${h.state}${h.reason ? ' ' + h.reason : ''}` : ' orden';
      const summary = el('summary', `${h.at}  ${h.from} → ${h.to}  ${h.message}${outcome}${h.lost ? ' · perdido' : ''}`);
      const details = el('details');
      details.append(summary, el('pre', h.xml));
      item.append(details);
      list.append(item);
    }
    nodes.push(list);
    return nodes;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    try {
      const p = await call('POST', '/api/payments', {
        from: data.get('from'),
        llave: data.get('llave'),
        amount: data.get('amount'),
      });
      show(...payment(p));
      await refresh();
    } catch (error) {
      failure(error);
    }
  });

  form.querySelector('[data-action="resolve"]')!.addEventListener('click', async () => {
    try {
      const r = await call('POST', '/api/resolve', { llave: new FormData(form).get('llave') });
      show(el('p', `${r.llave} pertenece a ${r.name}, en ${r.institution}. Solo el nombre enmascarado sale de su red.`));
    } catch (error) {
      failure(error);
    }
  });

  form.querySelector('[data-action="settle"]')!.addEventListener('click', async () => {
    try {
      const s = await call('POST', '/api/settle');
      const nets = Object.entries(s.nets as Record<string, string>).map(([k, v]) => `${k} ${usd(v)}`).join(' · ');
      show(
        el('p', `Malla liquidada a las ${s.at}: ${s.payments} pagos por USD ${usd(s.gross)}, cerrados moviendo USD ${usd(s.net)} en el banco central.`),
        el('p', nets, 'demo__clock'),
      );
      await refresh();
    } catch (error) {
      failure(error);
    }
  });

  if (api) {
    refresh()
      .then(() => {
        document.getElementById('controls')!.hidden = false;
        document.getElementById('offline')!.hidden = true;
      })
      .catch(() => {});
  }
</script>

<style>
  .demo__kicker {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .demo__disclaimer {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .demo__panel {
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: var(--paper-raised);
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .demo__panel label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .demo__panel select,
  .demo__panel input {
    display: block;
    width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--paper);
    font: inherit;
    font-weight: 400;
  }
  .demo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0;
  }
  .demo__actions button {
    cursor: pointer;
  }
  .demo__headline {
    font-weight: 600;
  }
  .demo__error {
    color: #9f1239;
  }
  .demo__state--ACSP,
  .demo__state--ACSC {
    color: var(--accent-dark);
    font-weight: 600;
  }
  .demo__state--RJCT {
    color: #9f1239;
    font-weight: 600;
  }
  .demo__hops {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    padding-left: 1.2rem;
  }
  .demo__hops summary {
    cursor: pointer;
    white-space: pre-wrap;
  }
  .demo__hops pre {
    max-height: 22rem;
    overflow: auto;
    font-size: 0.75rem;
  }
  #network :global(td) {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .demo__clock {
    color: var(--muted);
    font-size: 0.85rem;
  }
  :global(.light--verde) {
    color: #166534;
  }
  :global(.light--amarillo) {
    color: #a16207;
  }
  :global(.light--naranja) {
    color: #c2410c;
  }
  :global(.light--rojo) {
    color: #9f1239;
    font-weight: 600;
  }
</style>
